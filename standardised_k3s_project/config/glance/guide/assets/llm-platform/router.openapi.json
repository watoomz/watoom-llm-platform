{
  "openapi": "3.1.0",
  "info": {
    "title": "WatooM production router contract",
    "version": "2026-11-03",
    "description": "Maintained router-owned routes and qualified inference entry points. Not a complete llama-server schema. No API-key enforcement is added by this Python router; use only the approved internal access boundary."
  },
  "servers": [
    {
      "url": "http://llm-router.llama-cpp.svc.cluster.local:8000"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "routerHealth",
        "description": "Process health and selected active deployment; does not prove inference correctness.",
        "responses": {
          "200": {
            "description": "Process health and selected active deployment; does not prove inference correctness.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Controller/backend unavailable or operation refused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listInferenceModels",
        "description": "OpenAI-compatible model discovery; listed does not imply loaded.",
        "responses": {
          "200": {
            "description": "OpenAI-compatible model discovery; listed does not imply loaded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Controller/backend unavailable or operation refused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "listLifecycleModels",
        "description": "Lifecycle catalog, including available_model_ids; inspect current catalog for detailed fields.",
        "responses": {
          "200": {
            "description": "Lifecycle catalog, including available_model_ids; inspect current catalog for detailed fields.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Controller/backend unavailable or operation refused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/status": {
      "get": {
        "operationId": "getLifecycleStatus",
        "description": "Current model lifecycle status; no explicit model-switch request.",
        "responses": {
          "200": {
            "description": "Current model lifecycle status; no explicit model-switch request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Controller/backend unavailable or operation refused",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/load": {
      "post": {
        "operationId": "loadManagedModel",
        "description": "Mutating controller-mediated model switch. Administrative workflow; not discovery.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  }
                },
                "required": [
                  "model"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Loaded model identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Unknown model",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Busy/unavailable/controller refusal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "chatCompletions",
        "description": "Forwarded to selected backend. Backend template determines supported tools/vision/reasoning/parameters. SSE chunks may contain role-only, text, reasoning or partial tool calls; [DONE] terminates a stream.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "model",
                  "messages"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Backend JSON result or SSE stream",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unsupported request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "No eligible model/controller unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/completions": {
      "post": {
        "operationId": "textCompletions",
        "description": "Forwarded to selected backend. Backend template determines supported tools/vision/reasoning/parameters. SSE chunks may contain role-only, text, reasoning or partial tool calls; [DONE] terminates a stream.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "prompt": {}
                },
                "required": [
                  "model",
                  "prompt"
                ],
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Backend JSON result or SSE stream",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unsupported request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "No eligible model/controller unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "x-source": "ansible/roles/llm-model-lab/files/gpu-controller-router.py"
}

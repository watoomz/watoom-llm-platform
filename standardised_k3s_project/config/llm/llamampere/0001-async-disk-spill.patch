+static server_prompt text_prompt(int id, size_t n_tokens) {
+    server_prompt p;
+    p.tokens = server_tokens(make_entry(id, n_tokens, 0).tokens, false);
+    return p;
+}
+
+// --cache-disk-async: an eviction is handed to the background writer; the server loop goes on without waiting for
+// the file I/O, can take the index lock while the file is being written, and a full queue drops instead of blocking
+static void test_async_spill(const std::string & root) {
+    const std::string dir = root + "/async";
+
+    std::atomic<bool> entered{false};
+    std::atomic<bool> release{false};
+
+    {
+        server_prompt_cache pc(1024, 0);
+        pc.disk = make_tier(dir, "k", 0);
+        pc.disk_async_max = 1;
+        pc.disk.before_write_file_fn = [&]() {
+            entered = true;
+            while (!release) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            }
+        };
+
+        const server_prompt a = text_prompt(11, 300);
+        const server_prompt b = text_prompt(12, 400);
+        const server_prompt c = text_prompt(13, 500);
+
+        CHECK(pc.alloc(a, 1*MiB, 0) != nullptr);
+        CHECK(pc.alloc(b, 1*MiB, 0) != nullptr);
+        CHECK(pc.alloc(c, 1*MiB, 0) != nullptr);
+        CHECK(pc.states.size() == 3);
+
+        // evict a: queued; the writer takes it and stops inside write_file, i.e. without the lock
+        pc.limit_size = 2*MiB + 512*1024;
+        pc.update();
+        CHECK(pc.states.size() == 2);
+        for (int i = 0; i < 5000 && !entered; ++i) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        CHECK(entered);
+
+        {
+            // the index lock is free while the entry is being written: lookups and /metrics do not wait for I/O
+            std::unique_lock<std::mutex> lock(pc.disk_mtx, std::try_to_lock);
+            CHECK(lock.owns_lock());
+            CHECK(pc.disk_async_pending() == 1);
+            CHECK(pc.disk.n_match() == 0); // not on disk yet, so not found by lookups
+        }
+
+        // evict b while a is still being written: the queue (max 1) is full, so b is dropped, not waited for
+        pc.limit_size = 1*MiB + 512*1024;
+        const int64_t t0 = ggml_time_us();
+        pc.update();
+        CHECK(ggml_time_us() - t0 < 1000*1000);
+        CHECK(pc.states.size() == 1);
+        {
+            std::lock_guard<std::mutex> lock(pc.disk_mtx);
+            CHECK(pc.n_disk_async_drops == 1 && pc.bytes_disk_async_drops == 1*MiB);
+        }
+
+        release = true;
+        pc.disk_drain();
+        {
+            std::lock_guard<std::mutex> lock(pc.disk_mtx);
+            CHECK(pc.disk_async_pending() == 0);
+            CHECK(pc.n_disk_async_writes == 1);
+            CHECK(pc.disk.n_match() == 1);
+            CHECK(find_entry(pc.disk, a.tokens.get_text_tokens()) != pc.disk.entries.end());
+            CHECK(find_entry(pc.disk, b.tokens.get_text_tokens()) == pc.disk.entries.end());
+        }
+
+        // a lookup restores the background-written entry from disk
+        server_prompt_disk_record r;
+        CHECK(pc.disk.read(find_entry(pc.disk, a.tokens.get_text_tokens()), r) && r.tokens == a.tokens.get_text_tokens());
+        CHECK(r.main.size() == 1*MiB);
+
+        // flush_to_disk waits for the queue, then writes the RAM entry (c) synchronously
+        pc.disk.before_write_file_fn = nullptr;
+        pc.flush_to_disk();
+        CHECK(pc.disk.n_match() == 2);
+
+        // queued at destruction: the destructor lets the writer finish it
+        const server_prompt d = text_prompt(14, 600);
+        CHECK(pc.alloc(d, 1*MiB, 0) != nullptr);
+        pc.limit_size = 1*MiB + 512*1024;
+        pc.update(); // evicts c (already on disk: the writer finds it there and writes nothing)
+        pc.disk_drain();
+        pc.limit_size = 512*1024;
+        pc.update(); // evicts d
+    }
+
+    server_prompt_disk_tier t = make_tier(dir, "k", 0);
+    CHECK(t.n_match() == 3);
+    CHECK(count_files(dir, ".tmp") == 0);
+
+    // 0 = synchronous, as before: on disk when update() returns
+    {
+        const std::string dir0 = root + "/async0";
+        server_prompt_cache pc(1024, 0);
+        pc.disk = make_tier(dir0, "k", 0);
+        pc.disk_async_max = 0;
+        CHECK(pc.alloc(text_prompt(21, 300), 1*MiB, 0) != nullptr);
+        pc.limit_size = 512*1024;
+        pc.update();
+        CHECK(pc.disk.n_match() == 1 && pc.n_disk_async_writes == 0);
+    }
+}
+
 int main() {
     const std::string root = (fs::temp_directory_path() / ("llama.cpp-pcdisk-test-" + std::to_string((long long) std::chrono::steady_clock::now().time_since_epoch().count()))).string();
     fs::create_directories(root);
@@ -1066,6 +1178,7 @@ int main() {
     test_owned_spec_state(root);
     test_fit_ram(root);
     test_disk_lookup_ram(root);
+    test_async_spill(root);
 

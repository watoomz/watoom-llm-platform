After=k3s.service
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /data/ai/helper-scripts/homelab-workspace-policy/capability_maintenance.py --iac-root /data/ai/projects/homelab/homelab-llm/standardised_k3s_project

diff --git a/packages/core/src/watoom/dungeon-contract.ts b/packages/core/src/watoom/dungeon-contract.ts
new file mode 100644
index 0000000..9721056
--- /dev/null
+++ b/packages/core/src/watoom/dungeon-contract.ts
@@ -0,0 +1,18 @@
+/** Bounded native dungeon options for the existing world.compose operation. */
+export const dungeonOutputs=["dungeon.umap","asset.glb","perspective.png","manifest.json","validation.json","dungeon-layout.json","dungeon-assembly.json","provenance.json"]
+export function validateDungeon(value:unknown) {
+ if (typeof value!=="object" || value===null || Array.isArray(value)) throw Error("Invalid dungeon options")
+ const options=value as Record<string,unknown>
+ const allowed=["style","rooms","levels","grid","room_size","cell_size","floor_height"]
+ if(Object.keys(options).some(key=>!allowed.includes(key))) throw Error("Unknown dungeon option")
+ if(!["dungeon-builder","dungeon-forge","mixed"].includes(String(options.style))) throw Error("Invalid dungeon style")
+ const defaults:Record<string,number>={rooms:12,levels:1,grid:8,room_size:600,cell_size:800,floor_height:400}
+ for(const key of Object.keys(defaults)) if(options[key]!==undefined) {
+  if(typeof options[key]!=="number" || !Number.isInteger(options[key])) throw Error("Integer dungeon dimensions required")
+  defaults[key]=Number(options[key])
+ }
+ const {rooms,levels,grid,room_size,cell_size,floor_height}=defaults
+ if(levels<1 || levels>4 || rooms<2*levels || rooms>64 || grid<2 || grid>16 || Math.ceil(rooms/levels)>grid*grid) throw Error("Dungeon layout outside bounds")
+ if(room_size<200 || room_size>=cell_size || cell_size>2000 || floor_height<300 || floor_height>1200) throw Error("Dungeon dimensions outside bounds")
+ return options
+}
diff --git a/packages/core/test/watoom-dungeon-contract.test.ts b/packages/core/test/watoom-dungeon-contract.test.ts
new file mode 100644
index 0000000..f6931ed
--- /dev/null
+++ b/packages/core/test/watoom-dungeon-contract.test.ts
@@ -0,0 +1,24 @@
+import {test,expect} from "bun:test"
+import {validate,outputs} from "../src/watoom/creative-contract"
+const id="ast_"+"a".repeat(24)
+const good={task:"3d-creative",operation:"world",asset_id:id,seed:42,dungeon:{style:"dungeon-builder",rooms:8,levels:2}}
+test("native dungeon stays in world.compose and requires editable map evidence",()=>{
+ expect(()=>validate(good,"world.compose")).not.toThrow()
+ expect(outputs(good)).toContain("dungeon.umap")
+ expect(outputs(good)).not.toContain("asset.blend")
+ expect(()=>validate({...good,operation:"inspect"},"asset.inspect")).toThrow()
+})
+test("dungeon dimensions, styles and references are bounded",()=>{
+ for(const dungeon of [
+ {style:"unknown"},{style:"dungeon-builder",rooms:65},{style:"dungeon-builder",levels:5},
+ {style:"dungeon-builder",rooms:2,levels:3},{style:"dungeon-builder",rooms:64,grid:2},
+ {style:"dungeon-builder",room_size:900},{style:"dungeon-builder",rooms:2.5},
+ {style:"dungeon-builder",script:"exec-anything"},
+ ]) expect(()=>validate({...good,dungeon},"world.compose")).toThrow()
+ for(const parameters of [{instances:3},[],false]) expect(()=>validate({...good,parameters},"world.compose")).toThrow()
+})
+test("mixed mode requires distinct indexed anchors",()=>{
+ expect(()=>validate({...good,dungeon:{style:"mixed"}},"world.compose")).toThrow()
+ expect(()=>validate({...good,asset_ids:[id],dungeon:{style:"mixed"}},"world.compose")).toThrow()
+ expect(()=>validate({...good,asset_ids:["ast_"+"b".repeat(24)],dungeon:{style:"mixed"}},"world.compose")).not.toThrow()
+})

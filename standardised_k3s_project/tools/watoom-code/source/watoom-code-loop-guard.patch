diff --git a/packages/core/src/session/runner/loop.ts b/packages/core/src/session/runner/loop.ts
new file mode 100644
index 0000000..01d0299
--- /dev/null
+++ b/packages/core/src/session/runner/loop.ts
@@ -0,0 +1,72 @@
+export * as SessionLoop from "./loop.js"
+
+import { SessionMessage } from "../message.js"
+
+const canonical = (value: unknown): string => {
+  if (Array.isArray(value)) return "[" + value.map(canonical).join(",") + "]"
+  if (value !== null && typeof value === "object")
+    return (
+      "{" +
+      Object.entries(value)
+        .toSorted(([a], [b]) => a.localeCompare(b))
+        .map(([key, item]) => JSON.stringify(key) + ":" + canonical(item))
+        .join(",") +
+      "}"
+    )
+  return JSON.stringify(value) ?? "undefined"
+}
+
+/** Uses the existing durable transcript, so restart cannot reset a stalled cycle.
+ * A fresh user request resets the boundary; changing results constitute progress.
+ * Live asynchronous jobs are a progress barrier, not a reason to cancel work.
+ */
+export const reason = (messages: ReadonlyArray<SessionMessage.Info>) => {
+  const boundary = messages.findLastIndex((message) => message.type === "user")
+  const calls = messages.slice(boundary + 1).flatMap((message) =>
+    message.type === "assistant"
+      ? message.content.flatMap((part) => {
+          if (part.type !== "tool" || (part.state.status !== "completed" && part.state.status !== "error")) return []
+          if (
+            part.name === "shell" &&
+            typeof part.state.input.command === "string" &&
+            /^\s*sleep\s+\d+(?:\.\d+)?\s*;?\s*$/.test(part.state.input.command)
+          )
+            return []
+          const running = part.state.content?.some((item) => {
+            if (item.type !== "text") return false
+            try {
+              const value: unknown = JSON.parse(item.text)
+              return (
+                value !== null &&
+                typeof value === "object" &&
+                "job_id" in value &&
+                "status" in value &&
+                (value.status === "running" || value.status === "starting")
+              )
+            } catch {
+              return false
+            }
+          })
+          if (running) return [null]
+          return [
+            canonical({
+              name: part.name,
+              input: part.state.input,
+              status: part.state.status,
+              result: part.state.status === "error" ? part.state.error : part.state.content,
+            }),
+          ]
+        })
+      : [],
+  )
+  const recent = calls.slice(calls.lastIndexOf(null) + 1).slice(-12)
+  for (const period of [1, 2, 3]) {
+    const tail = recent.slice(-period * 3)
+    if (tail.length === period * 3 && tail.every((value, index) => value === tail[index % period]))
+      return (
+        "Repeated tool cycle produced no new evidence across three attempts. Tools are disabled for this turn. " +
+        "Report the last verified result, any outstanding job IDs, and the exact blocker or changed hypothesis needed. " +
+        "Do not claim completion or restart existing work. Continue only after new user input."
+      )
+  }
+}
diff --git a/packages/core/test/session-loop.test.ts b/packages/core/test/session-loop.test.ts
new file mode 100644
index 0000000..6d53959
--- /dev/null
+++ b/packages/core/test/session-loop.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, test } from "bun:test"
+import { Schema } from "effect"
+import { SessionLoop } from "../src/session/runner/loop"
+import { SessionMessage } from "../src/session/message"
+
+const decode = Schema.decodeUnknownSync(SessionMessage.Info)
+const tool = (name = "execute", input: Record<string, string> = { code: "probe()" }, result = "unchanged") =>
+  decode({
+    id: "msg_test",
+    sessionID: "ses_test",
+    type: "assistant",
+    time: { created: 1 },
+    agent: "watoom-workflow",
+    model: { providerID: "test", id: "test" },
+    content: [
+      {
+        type: "tool",
+        id: "call_test",
+        name,
+        time: { created: 1 },
+        state: { status: "completed", input, content: [{ type: "text", text: result }] },
+      },
+    ],
+  })
+describe("durable no-progress loop boundary", () => {
+  test("stops identical results after three calls, not two", () => {
+    expect(SessionLoop.reason([tool(), tool()])).toBeUndefined()
+    expect(SessionLoop.reason([tool(), tool(), tool()])).toContain("three attempts")
+  })
+  test("detects alternating cycles and ignores sleeps", () => {
+    const a = tool("execute", { code: "a()" })
+    const b = tool("execute", { code: "b()" })
+    const sleep = tool("shell", { command: "sleep 60" })
+    expect(SessionLoop.reason([a, sleep, b, a, sleep, b, a, sleep, b])).toBeDefined()
+  })
+  test("changed results and changed arguments allow work", () => {
+    expect(SessionLoop.reason([tool(), tool(), tool("execute", { code: "probe()" }, "new evidence")])).toBeUndefined()
+    expect(SessionLoop.reason([tool(), tool(), tool("execute", { code: "repair()" })])).toBeUndefined()
+  })
+  test("running jobs are not false loop failures", () => {
+    const poll = tool("execute", { code: "status()" }, JSON.stringify({ job_id: "owned", status: "running" }))
+    expect(SessionLoop.reason([poll, poll, poll, poll])).toBeUndefined()
+    expect(SessionLoop.reason([tool(), tool(), poll, tool()])).toBeUndefined()
+  })
+  test("new user input resets the boundary", () => {
+    const user = decode({
+      id: "msg_user",
+      sessionID: "ses_test",
+      type: "user",
+      time: { created: 1 },
+      text: "Try the repaired route",
+    })
+    expect(SessionLoop.reason([tool(), tool(), user, tool()])).toBeUndefined()
+  })
+  test("serialized restart history retains protection", () => {
+    const saved = JSON.parse(
+      JSON.stringify([tool(), tool(), tool()].map((value) => Schema.encodeSync(SessionMessage.Info)(value))),
+    ).map(decode)
+    expect(SessionLoop.reason(saved)).toBeDefined()
+  })
+})

{# Recipe for the watoom-code-engineering base image used by Containerfile (moved from the retired
   opencode-agent role in T-0115). Render with the last values that role used:
     opencode_agent_v2_canary_version: 2.0.18
     opencode_agent_openspec_version: "1.13.2"
   e.g. python3 -c "import jinja2,sys; print(jinja2.Template(open(sys.argv[1]).read()).render(opencode_agent_v2_canary_version='2.0.18', opencode_agent_openspec_version='1.13.2'))" engineering-base.Dockerfile.j2 #}
FROM node:22-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive

# Keep the V2 canary coding toolchain at parity with the current V1
# watoom-opencode-coding image. OpenCode itself is the intentional variable.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       ca-certificates \
       curl \
       wget \
       git \
       git-lfs \
       openssh-client \
       rsync \
       jq \
       yq \
       ripgrep \
       fd-find \
       tree \
       file \
       less \
       vim-tiny \
       nano \
       procps \
       lsof \
       strace \
       dnsutils \
       netcat-openbsd \
       zip \
       unzip \
       xz-utils \
       bzip2 \
       gzip \
       tar \
       patch \
       diffutils \
       gettext \
       build-essential \
       gcc \
       g++ \
       clang \
       clangd \
       clang-format \
       clang-tidy \
       gdb \
       valgrind \
       cmake \
       ninja-build \
       meson \
       pkg-config \
       autoconf \
       automake \
       libtool \
       python3 \
       python-is-python3 \
       python3-dev \
       python3-pip \
       python3-venv \
       ansible-core \
       ansible-lint \
       libgl1 \
       libgl1-mesa-dri \
       libegl1 \
       libglx-mesa0 \
       mesa-utils \
       xvfb \
       xauth \
       libxcursor1 \
       libatk1.0-0 \
       libatk-bridge2.0-0 \
       libxcomposite1 \
       libxdamage1 \
       libxkbcommon0 \
       libpango-1.0-0 \
       libcairo2 \
       libatspi2.0-0 \
       pipx \
       golang-go \
       rustc \
       cargo \
       default-jdk-headless \
       maven \
       shellcheck \
       sqlite3 \
       libssl-dev \
       libffi-dev \
       zlib1g-dev \
       libbz2-dev \
       libreadline-dev \
       libsqlite3-dev \
       liblzma-dev \
       libxml2-dev \
       libxslt1-dev \
       libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && git lfs install --system \
    && (corepack enable || true)


ARG BLENDER_VERSION=4.2.23
ARG BLENDER_SERIES=4.2

RUN curl -fsSLo "/tmp/blender-${BLENDER_VERSION}-linux-x64.tar.xz" \
      "https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}-linux-x64.tar.xz" \
    && curl -fsSLo "/tmp/blender-${BLENDER_VERSION}.sha256" \
      "https://download.blender.org/release/Blender${BLENDER_SERIES}/blender-${BLENDER_VERSION}.sha256" \
    && cd /tmp \
    && grep "blender-${BLENDER_VERSION}-linux-x64.tar.xz" "blender-${BLENDER_VERSION}.sha256" | sha256sum -c - \
    && mkdir -p /opt/blender \
    && tar -xJf "/tmp/blender-${BLENDER_VERSION}-linux-x64.tar.xz" --strip-components=1 -C /opt/blender \
    && ln -sf /opt/blender/blender /usr/local/bin/blender \
    && rm -f "/tmp/blender-${BLENDER_VERSION}-linux-x64.tar.xz" "/tmp/blender-${BLENDER_VERSION}.sha256"


RUN npm install --global "@opencode/cli@{{ opencode_agent_v2_canary_version }}"

# OpenSpec CLI for the generated OPSX/OpenSpec workflow.
RUN npm install --global "@fission-ai/openspec@{{ opencode_agent_openspec_version }}" \
    && opencode --version \
    && mkdir -p /etc/opencode /workspace

# Headless Chromium capability for real HTML5/Canvas runtime validation.
# Browser binaries are shared outside /root so runtime UID 1009 can use them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV NODE_PATH=/usr/local/lib/node_modules

RUN npm install --global "playwright@1.63.0" \
    && playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright \
    && node -e 'const p = require("playwright"); if (!p.chromium) process.exit(1)' \
    && playwright --version

WORKDIR /workspace
ENTRYPOINT ["opencode"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]

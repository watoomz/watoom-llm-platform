  "placeholders": {
    "description": "Environment-identifying values are replaced in the exported copy only. The private homelab repository keeps the real values. tools/set-domain.py in the export maps the placeholders to a destination's own values.",
    "apply_to_prefixes": [
      "standardised_k3s_project/"
    ],
    "rules": [
      {
        "name": "domain",
        "pattern": "\\bwatoom\\.au\\b",
        "replace": "homelab.example"
      },
      {
        "name": "lan-subnet",
        "pattern": "\\b10\\.5\\.(\\d{1,3})\\.(\\d{1,3})\\b",
        "replace": "10.99.\\1.\\2"
      },
      {
        "name": "dmz-address",
        "pattern": "\\b192\\.168\\.0\\.(\\d{1,3})\\b",
        "replace": "192.168.250.\\1"
      },
      {
        "name": "github-owner",
        "pattern": "\\bwatoom[z]\\b",
        "replace": "YOUR_GITHUB_USER"
      },
      {
        "name": "k3s-pod-network",
        "pattern": "\\b10\\.42\\.0\\.(\\d{1,3})\\b",
        "replace": "10.242.0.\\1"
      },
      {
        "name": "k3s-service-network",
        "pattern": "\\b10\\.43\\.(\\d{1,3})\\.(\\d{1,3})\\b",
        "replace": "10.243.\\1.\\2"
      },
      {
        "name": "agent-identity-domain",
        "pattern": "\\bwatoom\\.(?:internal|local)\\b",
        "replace": "agent.example"
      },
      {
        "name": "agent-identity-name",
        "pattern": "\\bWatooM Homelab\\b",
        "replace": "Agent Export"
      },
      {
        "name": "router-vendor",
        "pattern": "(?i)router",
        "replace": "router"
      },
      {
        "name": "gpu-model",
        "pattern": "\\bRTX ?3080\\b",
        "replace": "GPU"
      },
      {
        "name": "host-name",
        "pattern": "\\bwatoom-homelab\\b(?![-.\\w])",
        "replace": "homelab-host"
      },
      {
        "name": "rig-windows-user",
        "pattern": "(?i)(Users\\\\{1,2})watoom\\b",
        "replace": "\\1RIG_USER"
      }
    ],
    "forbidden_after": [
      "\\bwatoom\\.au\\b",
      "\\b10\\.5\\.\\d{1,3}\\.\\d{1,3}\\b",
      "\\b192\\.168\\.0\\.225\\b",
      "\\bwatoom[z]\\b",
      "\\b10\\.42\\.0\\.\\d{1,3}\\b",
      "\\b10\\.43\\.\\d{1,3}\\.\\d{1,3}\\b",
      "\\bwatoom\\.(?:internal|local)\\b",
      "\\bWatooM Homelab\\b",
      "(?i)router",
      "\\bRTX ?3080\\b",
      "(?<!\")\\bwatoom-homelab\\b(?![-.\\w\"])",
      "(?i)Users\\\\{1,2}watoom\\b"
    ]
  },
  "regenerate": {
    "commands": [
      [
        "scripts/render-glance-configmaps.py",
        "python3"
      ],
      [
        "scripts/render-server-catalogue.py",
        "python3"
      ],
      [
        "scripts/render-glance-guide.py",
        "/data/ai/toolchains/docs-render/bin/python3"
      ]
    ],
    "verifier": [
      "scripts/verify-homelab-documentation.py",
      "python3"
    ]
  },
  "prune_missing_paths": [
    "ansible/inventories/homelab/group_vars/all.yml"
  ],
  "prune_glance": true,
  "prune_manifests": true
}

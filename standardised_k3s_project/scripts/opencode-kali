#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'EOF'
Usage:
  opencode-kali --target <authorized-profile> [--timeout SECONDS] -- "request"

Runs the dedicated watoom-kali OpenCode agent against an explicit target/profile.
The helper does not grant authorization; WatooM Kali MCP policy remains authoritative.
EOF
}

TARGET=""
TIMEOUT="${OPENCODE_KALI_TIMEOUT:-900}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      TARGET="$2"
      shift 2
      ;;
    --timeout)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      TIMEOUT="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

[ -n "$TARGET" ] || { echo "--target is required" >&2; usage >&2; exit 2; }
[ "$#" -gt 0 ] || { echo "request is required after --" >&2; usage >&2; exit 2; }
[[ "$TARGET" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || {
  echo "target contains unsupported characters" >&2
  exit 2
}
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || {
  echo "timeout must be seconds" >&2
  exit 2
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REQUEST="$*"

exec "$SCRIPT_DIR/opencode-overnight" run \
  --agent watoom-kali \
  --dir /workspace \
  --timeout "$TIMEOUT" \
  -- "Target/profile: ${TARGET}

Request:
${REQUEST}

First call watoom_kali_target_info for this exact target/profile. Continue only through typed watoom-kali MCP tools."

[Unit]
Description=WatooM constrained ansible-lint API for Open WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ ansible_lint_api_python_bin }} {{ ansible_lint_api_install_dir }}/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target

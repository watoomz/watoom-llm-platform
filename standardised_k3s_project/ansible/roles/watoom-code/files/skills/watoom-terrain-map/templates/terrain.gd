@tool
extends Node3D
## Real-world terrain built from a DEM heightmap.
##
## Generated by the watoom-terrain-map pipeline (lat/long -> open elevation DEM
## -> float EXR heightmap). This script is generic: only heightmap_path and the
## elevation range change per location, and the pipeline writes those into the
## scene's exported properties. Builds an ArrayMesh (with normals + UVs) plus a
## StaticBody3D/HeightMapShape3D collider at true-to-life world scale.
##
## The heightmap is a single-channel float EXR so Godot's Image.load() keeps full
## elevation precision (Image.load() quantizes a 16-bit PNG to 8 bits -> ~256
## height steps, which terraces gentle slopes). get_pixel().r reads the normalized
## 0..1 height for both EXR (FORMAT_RF) and legacy PNG, so either loads correctly.
##
## In the editor, tick "Build Now" to (re)generate. At runtime it builds in
## _ready() if nothing is built yet.
##
## Use height_at(x, z) to place characters, props and capture cameras on the
## ground instead of guessing a Y value: real terrain is NOT flat and the origin
## is not at min/max elevation.

@export_file("*.exr", "*.png") var heightmap_path: String = ""
## Square map edge length in metres (the real-world region size).
@export var world_size: float = 4000.0
## Real elevation (m) that heightmap value 0 and 65535 map to.
@export var height_min: float = 0.0
@export var height_max: float = 1.0
## Vertical exaggeration; 1.0 = true to life.
@export var height_scale: float = 1.0
## Mesh grid resolution (quads per side). Clamped to heightmap size - 1.
@export var mesh_resolution: int = 256
@export var add_collision: bool = true
@export var build_now: bool = false:
	set(v):
		build_now = false
		if v:
			build()

const MESH_NAME := "TerrainMesh"
const BODY_NAME := "TerrainBody"

var _heights := PackedFloat32Array()
var _cols: int = 0
var _span: float = 0.0


func _ready() -> void:
	if not Engine.is_editor_hint() and not has_node(MESH_NAME):
		build()


func _load_heights() -> Image:
	if heightmap_path.is_empty():
		push_error("terrain: heightmap_path not set")
		return null
	# Load the raw file (globalized) so the 16-bit elevation is read at full
	# precision, bypassing the texture importer which would quantize it.
	var img := Image.new()
	var gp := ProjectSettings.globalize_path(heightmap_path)
	if img.load(gp) == OK:
		return img
	if img.load(heightmap_path) == OK:
		return img
	push_error("terrain: cannot load heightmap " + heightmap_path)
	return null


func build() -> void:
	var img := _load_heights()
	if img == null:
		return
	for n: String in [MESH_NAME, BODY_NAME]:
		if has_node(n):
			get_node(n).queue_free()

	var w := img.get_width()
	var h := img.get_height()
	var res: int = clampi(mesh_resolution, 2, mini(w, h) - 1)
	var span := float(world_size)
	var vrange := (height_max - height_min) * height_scale

	# Sample the heightmap on a (res+1) grid, bilinear, into metres.
	var cols := res + 1
	var heights := PackedFloat32Array()
	heights.resize(cols * cols)
	for r in cols:
		var fy := float(r) / float(res) * float(h - 1)
		var y0 := int(fy)
		var dy := fy - y0
		var y1 := mini(y0 + 1, h - 1)
		for c in cols:
			var fx := float(c) / float(res) * float(w - 1)
			var x0 := int(fx)
			var dx := fx - x0
			var x1 := mini(x0 + 1, w - 1)
			var t: float = lerp(img.get_pixel(x0, y0).r, img.get_pixel(x1, y0).r, dx)
			var b: float = lerp(img.get_pixel(x0, y1).r, img.get_pixel(x1, y1).r, dx)
			var norm: float = lerp(t, b, dy)   # 0..1
			heights[r * cols + c] = height_min * height_scale + norm * vrange
	_heights = heights
	_cols = cols
	_span = span

	# Build the visual mesh. Normals come straight from the height grid (central
	# differences) so they always point up, and triangles are wound so the top
	# face is the front face (Godot culls back faces). Getting either wrong
	# renders the terrain invisible from above / lit from below.
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var half := span * 0.5
	var step := span / float(res)
	for r in cols:
		var wz := -half + float(r) / float(res) * span
		for c in cols:
			var wx := -half + float(c) / float(res) * span
			var hl: float = heights[r * cols + maxi(c - 1, 0)]
			var hr: float = heights[r * cols + mini(c + 1, res)]
			var hd: float = heights[maxi(r - 1, 0) * cols + c]
			var hu: float = heights[mini(r + 1, res) * cols + c]
			st.set_normal(Vector3(hl - hr, 2.0 * step, hd - hu).normalized())
			st.set_uv(Vector2(float(c) / float(res), float(r) / float(res)))
			st.add_vertex(Vector3(wx, heights[r * cols + c], wz))
	for r in res:
		for c in res:
			var i := r * cols + c
			st.add_index(i)
			st.add_index(i + 1)
			st.add_index(i + cols)
			st.add_index(i + 1)
			st.add_index(i + cols + 1)
			st.add_index(i + cols)
	st.generate_tangents()
	var mesh := st.commit()

	var mi := MeshInstance3D.new()
	mi.name = MESH_NAME
	mi.mesh = mesh
	var mat_path := heightmap_path.get_base_dir().path_join("terrain_material.gdshader")
	if ResourceLoader.exists(mat_path):
		var sm := ShaderMaterial.new()
		sm.shader = load(mat_path)
		sm.set_shader_parameter("world_min_y", height_min * height_scale)
		sm.set_shader_parameter("world_max_y", height_max * height_scale)
		mi.material_override = sm
	add_child(mi)
	if Engine.is_editor_hint() and get_tree() != null:
		mi.owner = get_tree().edited_scene_root

	# Collision from the same height grid.
	if add_collision:
		var shape := HeightMapShape3D.new()
		shape.map_width = cols
		shape.map_depth = cols
		shape.map_data = heights
		var col := CollisionShape3D.new()
		col.shape = shape
		# HeightMapShape3D is unit-spaced on X/Z; scale to world span.
		var body := StaticBody3D.new()
		body.name = BODY_NAME
		body.add_child(col)
		body.scale = Vector3(span / float(res), 1.0, span / float(res))
		add_child(body)
		if Engine.is_editor_hint() and get_tree() != null:
			body.owner = get_tree().edited_scene_root
			col.owner = get_tree().edited_scene_root


## Ground height (global Y, metres) under global point (x, z). Bilinear on the
## same grid as the mesh/collider. Builds the terrain first if needed. Points
## outside the map clamp to the nearest edge.
func height_at(x: float, z: float) -> float:
	if _heights.is_empty():
		build()
	if _heights.is_empty():
		return global_position.y
	var local := to_local(Vector3(x, 0.0, z))
	var res := _cols - 1
	var fx: float = clampf((local.x / _span + 0.5) * float(res), 0.0, float(res))
	var fz: float = clampf((local.z / _span + 0.5) * float(res), 0.0, float(res))
	var c0 := mini(int(fx), res - 1)
	var r0 := mini(int(fz), res - 1)
	var dx := fx - float(c0)
	var dz := fz - float(r0)
	var a: float = lerp(_heights[r0 * _cols + c0], _heights[r0 * _cols + c0 + 1], dx)
	var b: float = lerp(_heights[(r0 + 1) * _cols + c0], _heights[(r0 + 1) * _cols + c0 + 1], dx)
	var h: float = lerp(a, b, dz)
	return to_global(Vector3(local.x, h, local.z)).y

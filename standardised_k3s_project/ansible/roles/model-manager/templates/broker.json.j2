 "image_output_gid": {{ model_manager_image_output_gid | int }},
 "images": {"backend_auth_file": "/data/ai/private/model-manager/backend-key", "gguf": {{ model_manager_llama_image | to_json }}, "sdxl": {{ model_manager_sdxl_image | to_json }}, "sdxl_runtime": {{ model_manager_sdxl_runtime | to_json }}}

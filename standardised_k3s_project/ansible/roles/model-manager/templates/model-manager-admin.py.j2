#!/usr/bin/env python3
"""Normal installed administrative entry point; no recovery worktree dependency."""
import os,sys
from pathlib import Path
root=Path({{ model_manager_repository_root | to_json }})
if len(sys.argv)<2 or sys.argv[1] not in ("manage","cutover"):raise SystemExit("Usage: model-manager-admin.py manage|cutover ACTION ...")
script=root/"tools/model-manager"/(sys.argv[1]+".py")
if not script.is_file():raise SystemExit("Promote the reviewed source into the authoritative checkout before administration")
os.execv("/usr/bin/python3",["/usr/bin/python3",str(script),*sys.argv[2:]])

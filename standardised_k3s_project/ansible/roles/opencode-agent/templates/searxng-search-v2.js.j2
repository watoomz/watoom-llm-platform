const BASE_URL = {{ opencode_agent_searxng_url | to_json }}
const HARD_MAX_RESULTS = {{ opencode_agent_searxng_max_results | int }}
const REQUEST_TIMEOUT_MS = {{ opencode_agent_searxng_timeout_ms | int }}

function compactText(value, maxLength = 700) {
  if (value === null || value === undefined) return undefined

  const result = String(value)
    .replace(/\s+/g, " ")
    .trim()

  if (!result) return undefined

  return result.length <= maxLength
    ? result
    : result.slice(0, maxLength - 1) + "…"
}

function compactArray(value) {
  if (!Array.isArray(value)) return []

  return value
    .map((item) => compactText(item, 100))
    .filter(Boolean)
}

export default {
  id: "watoom.searxng-search",

  async setup(ctx) {
    await ctx.tool.transform((editor) => {
      editor.add({
        name: "searxng_search",

        description:
          "Search the public internet using the internal WatooM SearXNG service. " +
          "Use this before webfetch when an external URL is not already known. " +
          "Returns compact titles, URLs, snippets and source engines.",

        input: {
          type: "object",

          properties: {
            query: {
              type: "string",
              minLength: 1,
              maxLength: 500,
              description: "Search query",
            },

            categories: {
              type: "string",
              maxLength: 200,
              description:
                "Optional comma-separated categories such as general,it,images,news",
            },

            language: {
              type: "string",
              maxLength: 32,
              description:
                "Optional SearXNG language such as en or en-US",
            },

            time_range: {
              type: "string",
              enum: ["day", "month", "year"],
              description: "Optional search time range",
            },

            page: {
              type: "integer",
              minimum: 1,
              maximum: 5,
              description: "Result page; defaults to 1",
            },

            limit: {
              type: "integer",
              minimum: 1,
              maximum: HARD_MAX_RESULTS,
              description:
                `Maximum compact results; maximum ${HARD_MAX_RESULTS}`,
            },
          },

          required: ["query"],
          additionalProperties: false,
        },

        async execute(input, context) {
          const query = String(input.query ?? "").trim()

          if (!query) {
            throw new Error("query must not be empty")
          }

          const page =
            Number.isInteger(input.page)
              ? input.page
              : 1

          const limit = Math.min(
            Number.isInteger(input.limit)
              ? input.limit
              : HARD_MAX_RESULTS,
            HARD_MAX_RESULTS,
          )

          const params = new URLSearchParams({
            q: query,
            format: "json",
            pageno: String(page),
          })

          if (input.categories) {
            params.set(
              "categories",
              String(input.categories).trim(),
            )
          }

          if (input.language) {
            params.set(
              "language",
              String(input.language).trim(),
            )
          }

          if (input.time_range) {
            params.set(
              "time_range",
              String(input.time_range),
            )
          }

          const url =
            `${BASE_URL.replace(/\/+$/, "")}/search?${params.toString()}`

          const timeoutController = new AbortController()

          const timer = setTimeout(
            () => timeoutController.abort(),
            REQUEST_TIMEOUT_MS,
          )

          const sessionAbort = () =>
            timeoutController.abort()

          if (context?.signal) {
            if (context.signal.aborted) {
              timeoutController.abort()
            } else {
              context.signal.addEventListener(
                "abort",
                sessionAbort,
                { once: true },
              )
            }
          }

          let response

          try {
            response = await fetch(url, {
              method: "GET",
              headers: {
                Accept: "application/json",
              },
              signal: timeoutController.signal,
            })
          } catch (error) {
            if (timeoutController.signal.aborted) {
              throw new Error(
                `SearXNG request aborted or timed out after ${REQUEST_TIMEOUT_MS}ms`,
              )
            }

            throw new Error(
              "SearXNG request failed: " +
              (
                error instanceof Error
                  ? error.message
                  : String(error)
              ),
            )
          } finally {
            clearTimeout(timer)

            if (context?.signal) {
              context.signal.removeEventListener(
                "abort",
                sessionAbort,
              )
            }
          }

          if (!response.ok) {
            const body = compactText(
              await response.text(),
              400,
            )

            throw new Error(
              `SearXNG HTTP ${response.status}` +
              (body ? `: ${body}` : ""),
            )
          }

          let payload

          try {
            payload = await response.json()
          } catch (error) {
            throw new Error(
              "SearXNG returned invalid JSON: " +
              (
                error instanceof Error
                  ? error.message
                  : String(error)
              ),
            )
          }

          const rawResults =
            Array.isArray(payload?.results)
              ? payload.results
              : []

          const results = rawResults
            .slice(0, limit)
            .map((result, index) => {
              const item = {
                rank: index + 1,
                title: compactText(
                  result?.title,
                  300,
                ),
                url: compactText(
                  result?.url,
                  2000,
                ),
                snippet: compactText(
                  result?.content,
                  700,
                ),
                engines: compactArray(
                  result?.engines,
                ),
              }

              const category =
                compactText(result?.category, 100)

              const published =
                compactText(
                  result?.publishedDate ??
                  result?.published_date,
                  100,
                )

              if (category) {
                item.category = category
              }

              if (published) {
                item.published = published
              }

              return item
            })
            .filter(
              (result) =>
                result.title || result.url,
            )

          return {
            content: JSON.stringify(
              {
                query,
                page,
                returned: results.length,
                available_on_page:
                  rawResults.length,
                results,
              },
              null,
              2,
            ),
          }
        },
      })
    })

    const tools = await ctx.tool.list()

    if (
      !tools.some(
        (tool) =>
          tool.id === "searxng_search",
      )
    ) {
      throw new Error(
        "searxng_search registration verification failed",
      )
    }
  },
}

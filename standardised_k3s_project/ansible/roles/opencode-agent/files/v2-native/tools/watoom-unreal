#!/usr/bin/env bash
set -euo pipefail

ENGINE_ROOT="${WATOOM_UNREAL_ENGINE_ROOT:-/opt/unreal-engine}"
ASSET_ROOT="${WATOOM_UNREAL_ASSET_ROOT:-/assets/unreal}"
CACHE_ROOT="${WATOOM_UNREAL_CACHE_ROOT:-/cache/unreal}"
ARTIFACT_ROOT="${WATOOM_UNREAL_ARTIFACT_ROOT:-/artifacts/unreal}"

# Host fallbacks.
[[ -d "$ENGINE_ROOT" ]] ||
    ENGINE_ROOT=/data/ai/assets/unreal-engine
[[ -d "$ASSET_ROOT" ]] ||
    ASSET_ROOT=/data/ai/assets/unreal
[[ -d "$CACHE_ROOT" ]] ||
    CACHE_ROOT=/data/ai/caches/unreal
[[ -d "$ARTIFACT_ROOT" ]] ||
    ARTIFACT_ROOT=/data/ai/artifacts/unreal

usage() {
    cat <<'USAGE'
Usage:
  watoom-unreal paths
  watoom-unreal discover [root]
  watoom-unreal doctor
  watoom-unreal validate <project.uproject>
USAGE
}

paths() {
    echo "ENGINE_ROOT=$ENGINE_ROOT"
    echo "ASSET_ROOT=$ASSET_ROOT"
    echo "CACHE_ROOT=$CACHE_ROOT"
    echo "ARTIFACT_ROOT=$ARTIFACT_ROOT"
}

discover() {
    local root="${1:-/workspace}"

    paths

    echo
    echo "=== PROJECTS ==="
    find "$root" -maxdepth 8 -type f -name '*.uproject' -print 2>/dev/null || true

    echo
    echo "=== PLUGINS ==="
    find "$root" -maxdepth 10 -type f -name '*.uplugin' -print 2>/dev/null || true
}

doctor() {
    local failed=0
    local blocked=0

    paths

    echo
    echo "=== TOOLCHAIN ==="

    for c in \
        clang clang++ gcc g++ cmake ninja gdb git python3 \
        Xvfb xvfb-run glxinfo
    do
        if command -v "$c" >/dev/null 2>&1; then
            echo "$c=PASS"
        else
            echo "$c=ABSENT"
            failed=1
        fi
    done

    echo
    echo "=== ENGINE ==="

    for f in \
        Engine/Binaries/Linux/UnrealEditor \
        Engine/Binaries/Linux/UnrealEditor-Cmd \
        Engine/Build/BatchFiles/RunUAT.sh
    do
        if [[ -x "$ENGINE_ROOT/$f" ]]; then
            echo "$f=PASS"
        else
            echo "$f=ABSENT"
            blocked=1
        fi
    done

    echo
    if (( failed )); then
        echo "RESULT=FAIL"
        return 1
    elif (( blocked )); then
        echo "RESULT=BLOCKED_ENGINE_NOT_INSTALLED"
        return 2
    else
        echo "RESULT=PASS"
    fi
}

validate() {
    local project="${1:-}"

    [[ -n "$project" ]] || {
        echo "ERROR: project required" >&2
        exit 64
    }

    project="$(readlink -f "$project")"
    [[ -f "$project" ]] || {
        echo "ERROR: project not found: $project" >&2
        exit 66
    }

    local cmd stamp out rc
    cmd="$ENGINE_ROOT/Engine/Binaries/Linux/UnrealEditor-Cmd"
    stamp="$(date +%Y%m%d-%H%M%S)"
    out="$ARTIFACT_ROOT/validation/$stamp"

    mkdir -p "$out"
    exec > >(tee "$out/validation.log") 2>&1

    echo "PROJECT=$project"
    echo "ENGINE_ROOT=$ENGINE_ROOT"
    echo "OUTPUT=$out"

    python3 - "$project" <<'PY'
import json
import pathlib
import sys

p = pathlib.Path(sys.argv[1])
with p.open() as fh:
    data = json.load(fh)

print("UPROJECT_JSON=PASS")
print("EngineAssociation=" + str(data.get("EngineAssociation", "")))

for module in data.get("Modules", []):
    print(
        "Module="
        + str(module.get("Name", ""))
        + " Type="
        + str(module.get("Type", ""))
    )

for plugin in data.get("Plugins", []):
    if plugin.get("Enabled"):
        print("Plugin=" + str(plugin.get("Name", "")))
PY

    [[ -x "$cmd" ]] || {
        echo "RESULT=BLOCKED_ENGINE_NOT_INSTALLED"
        return 2
    }

    echo
    echo "=== PROJECT LOAD ==="

    set +e
    timeout --signal=TERM --kill-after=15s 240s \
        "$cmd" \
        "$project" \
        -unattended \
        -nop4 \
        -nosplash \
        -NullRHI \
        -ddc=NoZenLocalFallback \
        -LocalDataCachePath=/home/opencode/.cache/UnrealEngine/DerivedDataCache \
        -ExecCmds='QUIT_EDITOR' \
        -stdout \
        -FullStdOutLogOutput \
        2>&1 |
        tee "$out/project-load.log"
    rc=${PIPESTATUS[0]}
    set -e

    echo "project_load_rc=$rc"
    (( rc == 0 )) || {
        echo "RESULT=FAIL"
        return "$rc"
    }

    echo
    echo "=== AUTOMATION ==="

    set +e
    timeout --signal=TERM --kill-after=15s 900s \
        "$cmd" \
        "$project" \
        -unattended \
        -nop4 \
        -nosplash \
        -NullRHI \
        -ddc=NoZenLocalFallback \
        -LocalDataCachePath=/home/opencode/.cache/UnrealEngine/DerivedDataCache \
        -ExecCmds='Automation RunTests Project;QUIT_EDITOR' \
        -stdout \
        -FullStdOutLogOutput \
        2>&1 |
        tee "$out/automation.log"
    rc=${PIPESTATUS[0]}
    set -e

    echo "automation_rc=$rc"
    (( rc == 0 )) || {
        echo "RESULT=FAIL"
        return "$rc"
    }

    echo
    echo "RESULT=PASS"
}

case "${1:-}" in
    paths)
        paths
        ;;
    discover)
        shift
        discover "$@"
        ;;
    doctor)
        doctor
        ;;
    validate)
        shift
        validate "$@"
        ;;
    *)
        usage
        exit 64
        ;;
esac
